# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key    # Settings → API → service_role
SUPABASE_ANON_KEY=your-anon-key               # Settings → API → anon public

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_API_SECRET=your-generated-secret-here

# ─── OAuth (only needed for one-click OAuth connect — API key works without these) ───
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3001/oauth/hubspot/callback

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3001/oauth/salesforce/callback

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3001/oauth/zoho/callback

DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_REDIRECT_URI=http://localhost:3001/oauth/dynamics/callback
DYNAMICS_TENANT_ID=common

# ─── WhatsApp Business API ───────────────────────────────────────────────────
# Set up at developers.facebook.com → My Apps → Create App → WhatsApp
WHATSAPP_PHONE_NUMBER_ID=        # From WhatsApp → Getting Started → Phone number ID
WHATSAPP_ACCESS_TOKEN=           # Permanent token from System User (Business Settings)
WHATSAPP_VERIFY_TOKEN=           # Any string you choose — used to verify the webhook
WHATSAPP_BUSINESS_NUMBER=        # Your WhatsApp number in international format e.g. 971501234567

# ─── Google OAuth (Gmail + Calendar) ─────────────────────────────────────────
# One OAuth client covers both Gmail and Calendar — same GOOGLE_CLIENT_ID / SECRET.
# Add BOTH redirect URIs in the Google Cloud Console → Authorised redirect URIs:
#   https://your-backend.up.railway.app/api/email/gmail/callback
#   https://your-backend.up.railway.app/api/calendar/callback
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.up.railway.app/api/email/gmail/callback
# Calendar callback is derived from API_BASE_URL automatically — no separate env var needed

# ─── Microsoft OAuth (Outlook connect) ───────────────────────────────────────
# Create at portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Backend base URL (used to build OAuth redirect URIs) ────────────────────
API_BASE_URL=https://your-backend.up.railway.app

# ─── Email (optional — needed for sending surveys by email) ───────────────────
# Sign up free at https://resend.com — 3,000 emails/month free
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=surveys@yourdomain.com

# ─── Context Engine AI keys (server-side — NOT per-user BYOK) ────────────────
# Anthropic Claude — used by context engine classify() and reason() methods
# Get key at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — used by embedding worker (text-embedding-3-small)
# REQUIRED for M2+ — embedding worker does not start without this key.
# Get key at platform.openai.com → API Keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
